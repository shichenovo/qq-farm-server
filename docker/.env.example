# ============================================================
# QQ Farm 全栈 Docker 部署配置
# 用法: 复制为 docker/.env 后填写(该文件已被 .gitignore 忽略，不会提交)
#   cp docker/.env.example docker/.env
# 然后: cd docker && docker compose up -d
# ============================================================

# ---- 面板账号(默认 admin/admin，部署后请尽快修改) ----
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 应用宝(YYB)换码 token ----
# 微信账号(loginType:yyb)登录必需。必填，否则微信换码通道失效。
YYB_API_TOKEN=REPLACE_WITH_YOUR_YYB_TOKEN

# ---- NapCat 扫码取码网页(8088)访问密码 ----
# 空=不校验；设上即开启(客户端用 Header x-auth-pwd 或 ?pwd= 传)
# 默认值 q20947154 为你此前指定的密码，请按需修改
NAPCAT_CODE_WEB_PASSWORD=q20947154

# ---- 微信(YYB)账号 openid ----
# 仅 yyb-keepalive 保活脚本使用；不填则保活跳过(账号长期停机可能 expired)
WX_OPENID=REPLACE_WITH_YOUR_WX_OPENID
