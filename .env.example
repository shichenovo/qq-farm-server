# ============================================================
# QQ Farm Bot 配置样例
# 用法: 复制为 /opt/qq-farm-bot-3010/.env 后填写
# 一键部署(setup.sh) 会自动复制本文件并交互替换 YYB token 占位符
# ============================================================

# ---- 面板账号 ----
# 用户名固定为 admin；密码默认 admin，请部署后尽快修改
ADMIN_USER=admin
ADMIN_PASSWORD=admin
ADMIN_PORT=3010

# ---- 运行环境 ----
TZ=Asia/Shanghai
NODE_ENV=production

# ---- NapCat 桥接 socket ----
# 与 napcat-farm 容器共享的 unix socket，路径务必与 systemd / docker 一致
NAPCAT_BRIDGE_SOCKET=/run/qqfarm-napcat-bridge/bridge.sock

# ---- 应用宝(YYB)换码 token ----
# 微信账号(loginType:yyb)登录必需。bot 读取顺序: YYB_API_KEY -> YYB_API_TOKEN
# 一键部署时由 setup.sh 交互填写并替换下方占位符；手动部署请改成你自己的
YYB_API_TOKEN=REPLACE_WITH_YOUR_YYB_TOKEN
