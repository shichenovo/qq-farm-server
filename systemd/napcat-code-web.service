[Unit]
Description=NapCat 扫码取 Code 网页（独立代理，不影响农场bot/yyb-go）
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/napcat-code-web
ExecStart=/usr/bin/node /opt/napcat-code-web/server.js
Restart=on-failure
RestartSec=3
# 监听端口、bridge socket 路径
Environment=PORT=8088
Environment=HOST=0.0.0.0
Environment=NAPCAT_BRIDGE_SOCKET=/run/qqfarm-napcat-bridge/bridge.sock
# 访问密码：空=不校验；设上即开启（客户端用 Header x-auth-pwd 或 ?pwd= 传）
Environment=NAPCAT_CODE_WEB_PASSWORD=q20947154

[Install]
WantedBy=multi-user.target
